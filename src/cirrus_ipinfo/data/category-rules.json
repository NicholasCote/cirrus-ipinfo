  "_org_keyword_comment": [
    "Case-insensitive regexes over the registry org name (maintainer handles such as HYDRA-MNT",
    "are ignored) and then the AS name's description (the part after the AS handle).",
    "Ordered: the first matching rule wins, so hosting is tested before ISP (an 'IDC' run by a",
    "telco is a data centre)."
  ],
  "org_keyword_rules": [
    ["\\b(universit\\w*|college|universidad\\w*|universidade|hochschule|polytechn\\w*|institute of technology|ecole normale)", "education_research", "university"],
    ["\\b(ministry|ministerio|minist[eè]re|government|gobierno|municipal\\w*)\\b", "government", "other"],
    ["\\b(foundation|fundaci[oó]n|stiftung|non-?profit)\\b", "nonprofit", "other"],
    ["(hosting|server|datacenter|data[ -]cent(er|re)|colo(cation|crossing)?\\b|\\bvps|dedicated|bare-?metal|\\bidc\\b|cloud|\\bhost)", "cloud", "hosting"],
    ["(telecom|telekom|telecomunica|telecommunica|\\btelco\\b|communications|comunica[cç]|\\bcable|cablevision|broadband|wireless|mobile|cellular|\\bfib(er|re|ra)\\b|\\binternet\\b|\\bisp\\b|\\bdsl\\b|satellite|starlink|telef[oó]nica|vodafone|\\borange\\b|comcast|verizon|charter|spectrum|\\bat&t\\b|unicom|chinanet|china telecom|china mobile|\\bcmnet\\b|rogers|\\bcox\\b|beltelecom|etisalat|kazakhtelecom)", "commercial", "isp_broadband"]
  ],

  "_ptr_label_comment": "Hostname tokens (split on '.' and '-', trailing digits dropped) that describe the line type.",
  "ptr_label_rules": [
    [["vps", "srv", "server", "hosting", "dedicated", "baremetal", "colo", "compute", "cloud"], "cloud", "hosting"],
    [["customer", "dynamic", "dyn", "dsl", "adsl", "vdsl", "xdsl", "cable", "pool", "dhcp", "broadband",
      "ftth", "fttx", "fttb", "fiber", "fibre", "residential", "res", "cpe", "ppp", "pppoe", "isp", "mobile",
      "lte", "subscriber", "abo", "lightspeed", "clientes", "retail"], "commercial", "isp_broadband"]
  ],

  "_company_suffix_comment": "Legal-form suffixes on the registry org / AS description: a for-profit company of unknown type.",
  "company_suffix": "\\b(inc|incorporated|llc|l\\.l\\.c|ltd|limited|corp|corporation|company|co\\.?,? ?ltd|gmbh|s\\.?a\\.?s|sarl|s\\.r\\.l|b\\.v|n\\.v|plc|pte|pty|k\\.k|eood|jsc|ooo|llp|ltda|s\\.p\\.a|s\\.a|s\\.a\\.? de c\\.v|s\\.l|ead|sp\\. ?z ?o\\.?o|d\\.o\\.o|kft|zrt|s\\.r\\.o|bhd|sdn|ab|as|oy|ag|ug|se|aps)\\.?(\\s*\\(.*\\))?\\s*$",

  "_company_prefix_comment": "Legal forms written before the name (Russian LLC/OOO/AO/PAO, Indonesian PT).",
  "company_prefix": "^(llc|ooo|ao|pao|zao|jsc|pt|cv)\\.?\\s+\\S",

  "ignore_org_names": ["(^|[-_ ])mnt([-_ ]|$)", "maint$", "^lir-", "^private customer$", "^-$"],

